# Kindle Scribe Delivery Configuration
# Copy this file to .env for local testing (optional)

# Your Kindle's unique Amazon email address
KINDLE_EMAIL=your_name_kindle@kindle.com

# SMTP Sender Credentials (e.g. Gmail)
SMTP_USER=your_email@gmail.com
# For Gmail, generate a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_PASS=xxxx xxxx xxxx xxxx

# SMTP Host & Port (defaults to Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
